# Runs the Checkmk agent for one query from the Checkmk server and,
# when called with "encrypt", encrypts its output in format "05".
# This follows optionally_encrypt() and encrypt_then_mac() of Checkmk's
# Linux agent (check_mk_agent.linux), as the FreeBSD agent does not
# encrypt. Differences: the secret is passed to openssl via a file
# descriptor instead of the command line, and hex is decoded with
# printf, as FreeBSD has no xxd.

AGENT=/usr/local/bin/check_mk_agent
SECRET_FILE=/usr/local/etc/checkmkagent/secret

# not an SSH session, even if the service was started from one
unset SSH_CLIENT SSH_CONNECTION SSH_TTY

panic()
{
	printf '<<<check_mk>>>\nEncryptionPanic: true\n'
	exit 1
}

if [ "${1}" != "encrypt" ]; then
	exec ${AGENT}
fi

hex_decode()
{
	hex=${1}
	while [ -n "${hex}" ]; do
		rest=${hex#??}
		printf "\\$(printf '%03o' "0x${hex%"${rest}"}")"
		hex=${rest}
	done
}

secret=$(cat "${SECRET_FILE}" 2>/dev/null)
[ -n "${secret}" ] || panic

kdf=$(openssl enc -aes-256-cbc -md sha256 -pbkdf2 -iter 600000 -pass fd:3 -P 3<<EOF2
${secret}
EOF2
) || panic
salt=$(echo "${kdf}" | sed -n 's/^salt=//p')
key=$(echo "${kdf}" | sed -n 's/^key=//p')
iv=$(echo "${kdf}" | sed -n 's/^iv *=//p')
[ ${#salt} -eq 16 ] && [ ${#key} -eq 64 ] && [ ${#iv} -eq 32 ] || panic

# the ciphertext is needed twice and may contain null bytes
ciphertext=$(${AGENT} | openssl enc -aes-256-cbc -K "${key}" -iv "${iv}" | openssl enc -base64) || panic

printf '05'
hex_decode "${salt}"
(
	hex_decode "${iv}"
	echo "${ciphertext}" | openssl enc -base64 -d
) | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${key}" -binary
echo "${ciphertext}" | openssl enc -base64 -d
