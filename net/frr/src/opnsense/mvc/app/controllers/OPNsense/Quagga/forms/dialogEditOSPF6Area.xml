<form>
    <field>
        <id>area.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <grid_view>
            <width>6em</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>area.id</id>
        <label>Area ID</label>
        <type>text</type>
        <help>Enter the area ID in dotted format, for example 0.0.0.1.</help>
    </field>
    <field>
        <id>area.type</id>
        <label>Area Type</label>
        <type>dropdown</type>
        <help>Select area behavior.</help>
        <grid_view>
            <formatter>area_type</formatter>
        </grid_view>
    </field>
    <field>
        <id>area.ranges</id>
        <label>Area Ranges</label>
        <style>tokenize</style>
        <type>select_multiple</type>
        <allownew>true</allownew>
        <help>Summarize networks from this area into one or more prefixes, for example 2001:db8::/32.</help>
        <grid_view>
            <visible>false</visible>
        </grid_view>
    </field>
    <field>
        <id>area.linkedPrefixlistIn</id>
        <label>Prefix-List In</label>
        <type>dropdown</type>
        <help>Filter inter-area prefixes announced into this area.</help>
        <grid_view>
            <visible>false</visible>
        </grid_view>
    </field>
    <field>
        <id>area.linkedPrefixlistOut</id>
        <label>Prefix-List Out</label>
        <type>dropdown</type>
        <help>Filter inter-area prefixes announced from this area.</help>
        <grid_view>
            <visible>false</visible>
        </grid_view>
    </field>
</form>
