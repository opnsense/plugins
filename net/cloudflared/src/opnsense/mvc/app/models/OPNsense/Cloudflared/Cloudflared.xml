<model>
    <mount>//OPNsense/Cloudflared</mount>
    <version>1.0.0</version>
    <description>Cloudflare Tunnel settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <token type="TextField">
                <Mask>/^[a-zA-Z0-9\._\-=+\/]+$/</Mask>
                <ValidationMessage>Token may only contain letters, digits, dots, underscores, equal signs, plus signs, slashes, and hyphens.</ValidationMessage>
            </token>
            <protocol type="OptionField">
                <Default>auto</Default>
                <Required>Y</Required>
                <OptionValues>
                    <auto/>
                    <quic/>
                    <http2/>
                </OptionValues>
            </protocol>
            <post_quantum type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </post_quantum>
            <quic_disable_pmtu_discovery type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </quic_disable_pmtu_discovery>
            <edge_ip_version type="OptionField">
                <BlankDesc>Default (IPv4)</BlankDesc>
                <OptionValues>
                    <ipv4 value="4">IPv4</ipv4>
                    <ipv6 value="6">IPv6</ipv6>
                    <auto value="auto">Auto</auto>
                </OptionValues>
            </edge_ip_version>
            <metrics_address type="TextField">
                <Default>localhost:2000</Default>
                <Mask>/^([a-zA-Z0-9\.\-]+|\[[0-9a-fA-F:]+\]):[0-9]{1,5}$/</Mask>
                <ValidationMessage>Enter the metrics address as host:port, e.g. localhost:2000.</ValidationMessage>
            </metrics_address>
            <log_level type="OptionField">
                <Default>info</Default>
                <Required>Y</Required>
                <OptionValues>
                    <info/>
                    <debug/>
                    <warn/>
                    <error/>
                    <fatal/>
                </OptionValues>
            </log_level>
        </general>
    </items>
</model>
